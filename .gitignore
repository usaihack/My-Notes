# ========================================
# My-Notes — .gitignore
# ========================================

# ----- Obsidian -----
.obsidian/
.trash/

# ----- OS Generated -----
.DS_Store
Thumbs.db
Desktop.ini
ehthumbs.db
._*
.Spotlight-V100
.Trashes

# ----- Editors / IDEs -----
.vscode/
.idea/
*.swp
*.swo
*~
*.sublime-*

# ----- MEGA Sync -----
.megaignore
*.mega

# ----- Temporary / Backup -----
*.tmp
*.temp
*.bak
*.backup
*.log

# ----- Archives -----
*.zip
*.rar
*.7z
*.tar.gz

# ----- Student Solution Files -----
# Keep solution files private
solutions/
**/my_solution*
**/my_answer*
**/*_solution.txt

# ----- Private / Personal -----
# Uncomment if you want to keep some notes private
# private/
# personal/
